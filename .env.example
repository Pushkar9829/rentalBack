PORT=5100
MONGODB_URI=mongodb://127.0.0.1:27017/rent_management
JWT_SECRET=change_this_jwt_secret_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
TZ=Asia/Kolkata

# WhatsApp Meta Cloud API (set WHATSAPP_MOCK=false when ready)
WHATSAPP_MOCK=true
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Razorpay (optional — leave empty to skip online payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Seed admin
SEED_ADMIN_EMAIL=admin@rentapp.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=System Admin
